# cmake build directory
/build/
/build_linux/
/dist/
/out/

# ide files
.vs
/.vscode/

# game assets and dumps
/files/

# on Windows the `shaders` and `audio` symlinks are replaced by directory
# junctions, which git walks into; ignore their contents (the real files are
# tracked under assets/shaders, and art/audio is CD-extracted audio)
/shaders/
/audio/

# The whole art tree comes off the original CDs and is not ours to ship: the
# README asks every user for their own copy of the game, so the repository
# must not hand them one. Extract it locally, see docs/ASSETS.md.
/art/

# Car tuning scripts come off the CD too (Scripts/cars), see docs/ASSETS.md
/scripts/cars/
/scripts/level01/

# save data
donut_save.dat
donut_progress.dat

# runtime-generated control bindings
keymap.conf

# runtime-generated shader binary cache
/cache/

# original CD archives (see docs/ASSETS.md) - never commit these
*.7z
*.iso
donut_coins.dat
